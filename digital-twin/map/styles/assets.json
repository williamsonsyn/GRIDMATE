{
  "halo_layer": {
    "id": "assets-halo",
    "type": "circle",
    "source": "assets-source",
    "paint": {
      "circle-radius": [
        "interpolate", ["linear"], ["zoom"],
        10, 10,
        14, 18
      ],
      "circle-color": [
        "match",
        ["get", "status"],
        "active", "#22c55e",
        "discharging", "#10b981",
        "charging", "#0ea5e9",
        "not_supplying", "#94a3b8",
        "#cbd5e1"
      ],
      "circle-opacity": 0.35,
      "circle-stroke-width": 1.5,
      "circle-stroke-color": "#ffffff"
    }
  },
  "circle_layer": {
    "id": "assets-circles",
    "type": "circle",
    "source": "assets-source",
    "paint": {
      "circle-radius": [
        "interpolate", ["linear"], ["zoom"],
        10, 7,
        14, 12
      ],
      "circle-color": [
        "match",
        ["get", "type"],
        "solar", "#f59e0b",
        "wind", "#06b6d4",
        "hydro", "#3b82f6",
        "battery", "#10b981",
        "grid", "#ef4444",
        "demand", "#8b5cf6",
        "#64748b"
      ],
      "circle-stroke-width": 2,
      "circle-stroke-color": "#ffffff"
    }
  },
  "label_layer": {
    "id": "assets-labels",
    "type": "symbol",
    "source": "assets-source",
    "layout": {
      "text-field": ["get", "name"],
      "text-font": ["Open Sans Regular", "Arial Unicode MS Regular"],
      "text-size": 11,
      "text-offset": [0, 1.4],
      "text-anchor": "top",
      "text-allow-overlap": false
    },
    "paint": {
      "text-color": "#1e293b",
      "text-halo-color": "#ffffff",
      "text-halo-width": 1.5
    }
  }
}

