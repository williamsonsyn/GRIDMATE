{
  "casing_layer": {
    "id": "roads-casing",
    "type": "line",
    "source": "roads-source",
    "paint": {
      "line-color": "#475569",
      "line-width": 3.5,
      "line-opacity": 0.5
    }
  },
  "line_layer": {
    "id": "roads-line",
    "type": "line",
    "source": "roads-source",
    "paint": {
      "line-color": [
        "match",
        ["get", "highway_type"],
        "motorway", "#f97316",
        "primary", "#fbbf24",
        "secondary", "#94a3b8",
        "#cbd5e1"
      ],
      "line-width": [
        "match",
        ["get", "highway_type"],
        "motorway", 2.8,
        "primary", 2.2,
        "secondary", 1.8,
        1.2
      ],
      "line-opacity": 0.85
    }
  }
}

