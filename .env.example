# ==============================================================================
# GridMate Application Configuration & Service Bindings (.env.example)
# ==============================================================================

# Application Execution Mode:
# 'auto' -> Try real models/solvers, gracefully fall back to mock data on error (default)
# 'real' -> Enforce real Member 1/2/3 modules (errors surface as HTTP 503)
# 'mock' -> Enforce built-in mock data for fast UI development
GRIDMATE_MODE=auto

# Allowed CORS origins for the FastAPI backend (comma-separated):
# In production on Vercel, requests to /api/ are proxied on the same origin.
GRIDMATE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vercel Large Functions Support (Opt-in to scale Python serverless bundle limit from 500 MB to 5 GB):
# Set this in Vercel Project Settings -> Environment Variables for heavy ML/solver packages (XGBoost/PyPSA)
VERCEL_SUPPORT_LARGE_FUNCTIONS=1

# Vercel Internal Service Bindings (Injected automatically by Vercel runtime):
# Leave blank for local development (defaults to direct in-process execution).
# On Vercel, these are populated by the declared bindings in vercel.json.
FORECASTING_SERVICE_URL=
OPTIMIZATION_SERVICE_URL=
DIGITAL_TWIN_SERVICE_URL=

# Frontend Configuration (Vite):
# VITE_API_BASE: Optional base URL for API requests. Keep empty in production
# to use relative /api paths routed via Vercel rewrites.
VITE_API_BASE=

# VITE_API_PROXY: Local development proxy target for Vite dev server (defaults to http://127.0.0.1:8000)
VITE_API_PROXY=http://127.0.0.1:8000

