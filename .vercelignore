# ==============================================================================
# GridMate Vercel Deployment Packaging Exclusions (.vercelignore)
# ==============================================================================

# Virtual environments in any directory or subdirectory
.venv
.venv/**
**/.venv
**/.venv/**
venv
venv/**
**/venv
**/venv/**
env
env/**
**/env
**/env/**
ENV
ENV/**

# Python cache, bytecode, and compilation artifacts
__pycache__
__pycache__/**
**/__pycache__
**/__pycache__/**
*.py[cod]
*.pyo
*$py.class
*.pyd

# Test, coverage, and linter caches
.pytest_cache
.pytest_cache/**
**/.pytest_cache
**/.pytest_cache/**
.mypy_cache
.mypy_cache/**
**/.mypy_cache/**
.ruff_cache
.ruff_cache/**
**/.ruff_cache/**
.coverage
.coverage.*
htmlcov
htmlcov/**

# Logs and runtime scratch files
logs
logs/**
**/logs
**/logs/**
*.log
backend/data/runtime/**

# Node dependencies (installed fresh by Vercel on build machines)
node_modules
node_modules/**
**/node_modules
**/node_modules/**

# Git and editor files
.git
.git/**
.github
.github/**
.vscode
.vscode/**
.idea
.idea/**
*.swp
*.swo
.DS_Store
Thumbs.db

# Local environment secrets and overrides
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

